# --- PowerPC port: bundle the Haiku demos and a curated set of applications
# and preferences. Limited to targets that build with the libraries available
# on ppc. OpenGL is now provided in-tree (resurrected Mesa 7.4.4 fork:
# libGL.so + Mesa Software Renderer), so GLTeapot is included; ffmpeg and
# libpng/jpeg are still absent, so media/image-heavy apps remain omitted.
SYSTEM_DEMOS += [ FFilterByBuildFeatures
	Chart
	GLTeapot
	Clock
	FontDemo
	Mandelbrot
	OverlayImage
	Pairs
	Playground
	Pulse
	Sudoku
] ;

