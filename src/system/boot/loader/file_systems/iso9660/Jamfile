SubDir HAIKU_TOP src system boot loader file_systems iso9660 ;

UsePrivateKernelHeaders ;
UsePrivateHeaders shared storage ;

SubDirC++Flags -fno-rtti ;

local platform ;
for platform in [ MultiBootSubDirSetup ] {
	on $(platform) {
		BootStaticLibrary [ MultiBootGristFiles boot_iso9660 ] :
			iso9660.cpp
		;
	}
}
