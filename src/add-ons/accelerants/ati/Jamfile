SubDir HAIKU_TOP src add-ons accelerants ati ;

UsePrivateHeaders graphics ;

# ppc bring-up: route the accelerant's TRACE calls to the syslog. The
# accelerant runs inside app_server and PowerMacs have no serial port, so
# without this its entire init path is invisible.
if $(TARGET_ARCH) = ppc {
	SubDirC++Flags -DENABLE_DEBUG_TRACE ;
}

UsePrivateHeaders [ FDirName graphics ati ] ;
UsePrivateHeaders [ FDirName graphics common ] ;

Addon ati.accelerant :
	accelerant.cpp
	cursor.cpp
	engine.cpp
	hooks.cpp
	mode.cpp
	overlay.cpp
		
	mach64_cursor.cpp
	mach64_dpms.cpp
	mach64_draw.cpp
	mach64_init.cpp
	mach64_mode.cpp
	mach64_overlay.cpp
	mach64_util.cpp
	
	rage128_cursor.cpp
	rage128_dpms.cpp
	rage128_draw.cpp
	rage128_init.cpp
	rage128_mode.cpp
	rage128_overlay.cpp

	: be libaccelerantscommon.a
;
